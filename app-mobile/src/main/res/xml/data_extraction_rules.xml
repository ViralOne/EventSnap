<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup/transfer rules. Same reasoning as backup_rules.xml: the encrypted settings file
  is useless without the keystore MasterKey, which never leaves the device, so don't carry it into a
  cloud backup or a device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="eventsnap_secure_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="eventsnap_secure_settings.xml" />
    </device-transfer>
</data-extraction-rules>
